# Candidate only. Replace hostname/certificate paths; validate with nginx -t.
# Put these directives inside http {}. Serve only apps/web/dist.
limit_req_zone $binary_remote_addr zone=wautech_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=wautech_api:10m rate=10r/s;
server {
    listen 80;
    server_name crm.example.invalid;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name crm.example.invalid;
    ssl_certificate /etc/wautech/tls/fullchain.pem;
    ssl_certificate_key /etc/wautech/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/wautech/current/web;
    client_max_body_size 6m;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /api/auth/login {
        limit_req zone=wautech_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 50s;
    }
    location /api/ {
        limit_req zone=wautech_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 50s;
    }
    location /actuator/ { return 404; }
    location /assets/ { try_files $uri =404; }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
