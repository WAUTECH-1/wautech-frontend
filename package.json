{
  "name": "wautech-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "workspaces/*",
    "packages/*"
  ],
  "scripts": {
    "verify:dev": "node scripts/verify-dev.mjs",
    "install:dependencies": "npm ci",
    "dev": "npm run dev --workspace=@wautech/wajahat",
    "dev:wajahat": "npm run dev --workspace=@wautech/wajahat",
    "dev:asad": "npm run dev --workspace=@wautech/asad",
    "dev:umer": "npm run dev --workspace=@wautech/umer",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
